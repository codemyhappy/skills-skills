{
  "name": "skills-skills",
  "version": "1.1.3",
  "description": "Personal skills management CLI — manage and sync your handwritten skills & skill-lock.json across devices (alias: ss).",
  "homepage": "https://github.com/codemyhappy/skills-skills",
  "bugs": {
    "url": "https://github.com/codemyhappy/skills-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemyhappy/skills-skills.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "skills-skills": "bin/ss.js",
    "ss": "bin/ss.js"
  },
  "files": [
    "bin/",
    "skills/",
    "SKILLS-GUIDE.md",
    "SKILLS-GUIDE.en.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "init": "node bin/ss.js init",
    "setup": "node bin/ss.js setup",
    "sync": "node bin/ss.js sync",
    "install:skills": "node bin/ss.js install"
  },
  "keywords": [
    "skills",
    "cli",
    "skills-management",
    "skill-lock",
    "opencli",
    "agent",
    "developer-tools",
    "sync",
    "three-way-merge",
    "handwritten-skills",
    "dotfiles",
    "nodejs",
    "typescript"
  ],
  "author": "codemyhappy",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
