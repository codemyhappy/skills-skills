{
  "name": "skills-skills",
  "version": "1.0.0",
  "description": "Personal skills management CLI — manage and sync your handwritten skills & skill-lock.json across devices (alias: ss).",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "skills-skills": "bin/ss.js",
    "ss": "bin/ss.js"
  },
  "files": [
    "bin/",
    "skills/",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "setup": "node bin/ss.js setup",
    "sync": "node bin/ss.js sync",
    "install:skills": "node bin/ss.js install"
  },
  "keywords": [
    "skills",
    "cli",
    "skills-management",
    "skill-lock",
    "opencli",
    "agent",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
